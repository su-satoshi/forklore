---
import Base from '../../layouts/Base.astro';
import { getPosts, url, slugify } from '../../lib/site';
const posts = await getPosts();
const counts = new Map<string, number>();
posts.forEach((p) => p.data.tags.forEach((t) => counts.set(t, (counts.get(t) ?? 0) + 1)));
const topics = [...counts.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---
<Base title="Topics" description="Browse ForkLore posts by topic.">
  <div class="wrap page">
    <h1 class="page-title">Topics</h1>
    {topics.length === 0 ? <p>No topics yet. Add <code>tags</code> to a post's front matter to create one.</p> : (
      <ul class="topic-list">
        {topics.map(([t, n]) => (
          <li><a href={url(`/topics/${slugify(t)}`)}>{t}</a> <span>{n} {n === 1 ? 'post' : 'posts'}</span></li>
        ))}
      </ul>
    )}
  </div>
</Base>
<style>
  .page { padding-top: 48px; max-width: 860px; }
  .topic-list { list-style: none; padding: 0; margin: 0; columns: 2 260px; column-gap: 40px; }
  .topic-list li { break-inside: avoid; padding: 10px 0; border-bottom: 1px solid var(--rule); display: flex; justify-content: space-between; gap: 12px; }
  .topic-list a { font-size: 1.25rem; font-weight: 700; text-decoration-color: transparent; }
  .topic-list a:hover { background: none; color: var(--accent); }
  .topic-list span { font-family: var(--font-mono); color: var(--label); font-size: 0.8rem; }
</style>
