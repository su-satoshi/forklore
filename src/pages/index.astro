---
import Base from '../layouts/Base.astro';
import PostGrid from '../components/PostGrid.astro';
import { getPosts } from '../lib/site';
const posts = await getPosts();
---
<Base>
  <div class="wrap home">
    <PostGrid
      posts={posts}
      filters
      intro="An independent tech blog on cybersecurity, AI vulnerabilities, blockchain cryptography, digital forensics and the hidden mechanics of online systems. Follow the evidence, question the assumptions, document the discoveries."
    />
  </div>
</Base>

<style>
  .home { padding-top: clamp(24px, 4vw, 40px); }
</style>
