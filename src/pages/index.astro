---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts, url, slugify } from '../lib/site';

const posts = await getPosts();
const latest = posts.slice(0, 8);
const counts = new Map<string, number>();
posts.forEach((p) => p.data.tags.forEach((t) => counts.set(t, (counts.get(t) ?? 0) + 1)));
const topics = [...counts.entries()].sort((a, b) => b[1] - a[1]);
---
<Base>
  <div class="wrap home">
    <section class="intro" aria-label="About ForkLore">
      <p>
        An independent tech blog on cybersecurity, AI vulnerabilities, blockchain cryptography, digital
        forensics and the hidden mechanics of online systems. From vibe-coded security flaws to
        algorithmic rabbit holes: follow the evidence, question the assumptions, document the discoveries.
      </p>
    </section>

    <div class="grid">
      <section aria-labelledby="latest">
        <h2 id="latest" class="section-title">Latest posts</h2>
        <PostList posts={latest} headingLevel="h3" />
        {posts.length > latest.length && <p class="more"><a href={url('/posts')}>See all {posts.length} posts</a></p>}
      </section>

      {topics.length > 0 && (
        <aside aria-labelledby="topics-h">
          <h2 id="topics-h" class="section-title">Browse by topic</h2>
          <ul class="tags">
            {topics.map(([t, n]) => <li><a class="tag" href={url(`/topics/${slugify(t)}`)}>{t} <span class="n">{n}</span></a></li>)}
          </ul>
        </aside>
      )}
    </div>
  </div>
</Base>

<style>
  .home { padding-top: 44px; }
  .intro p {
    margin: 0;
    max-width: 40ch;
    font-size: clamp(1.25rem, 2.4vw, 1.55rem);
    line-height: 1.45;
    font-weight: 500;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 56px;
    margin-top: 56px;
  }
  .section-title {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 18px;
    padding-bottom: 8px;
    border-bottom: 3px solid var(--ink);
  }
  aside .section-title { border-bottom-color: var(--orange); }
  .n { color: var(--ink-soft); font-weight: 400; margin-left: 2px; }
  .more { font-weight: 600; }
  @media (max-width: 820px) {
    .grid { grid-template-columns: 1fr; gap: 40px; }
    aside { order: -1; }
  }
</style>
