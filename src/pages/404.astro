---
import Base from '../layouts/Base.astro';
import { url } from '../lib/site';
---
<Base title="Page not found">
  <div class="wrap page">
    <h1 class="page-title">404: no record of this page</h1>
    <p>The link may be old or mistyped. Try the <a href={url('/posts')}>full list of posts</a> or go back to the <a href={url('/')}>home page</a>.</p>
  </div>
</Base>
<style>
  .page { padding-top: 64px; max-width: 760px; }
  .page-title { font-family: var(--font-display); font-weight: 400; font-size: clamp(2.8rem, 6.5vw, 4.2rem); letter-spacing: 0.02em; margin-bottom: 20px; }
</style>
