---
// The ForkLore cover collage, split into layers so some pieces can move.
// Layers are listed bottom to top, positioned on the original 1200 x 300 artboard.
import { url } from '../lib/site';

// bug and star extend above the frame (negative y): they sit cut off at the top edge,
// and show in full only while they move.
const layers = [
  { name: 'bg',     x: 0,   y: 0,   w: 1200, h: 300 },
  { name: 'cloud1', x: 770, y: 144, w: 306,  h: 156 },
  { name: 'scene',  x: 0,   y: 0,   w: 1200, h: 300 },
  { name: 'wifi',   x: 478, y: 22,  w: 100,  h: 100 },
  { name: 'plant',  x: 588, y: 84,  w: 53,   h: 120 },
  { name: 'star',   x: 611, y: -69, w: 137,  h: 131 },
  { name: 'man',    x: 560, y: 62,  w: 202,  h: 238 },
  { name: 'scene2', x: 0,   y: 0,   w: 1200, h: 300 },
  { name: 'bug',    x: 790, y: -37, w: 139,  h: 136 },
  { name: 'cloud2', x: 196, y: 22,  w: 175,  h: 90 },
  { name: 'note1',  x: 730, y: 103, w: 34,   h: 42 },
  { name: 'note2',  x: 760, y: 94,  w: 26,   h: 32 },
];
const fire = { x: 0, y: 236, w: 99, h: 64 };
const W = 1200, H = 300; // the original artboard
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
const box = (l: { x: number; y: number; w: number }) => `left:${pct(l.x, W)};top:${pct(l.y, H)};width:${pct(l.w, W)}`;
---
<div class="collage">
  <div class="static-wrap">
    <img class="static" src={url('/images/collage/static.webp')} width="2400" height="600" alt="ForkLore collage: a big yellow 'hi!' on orange, with a Melbourne tram trailing fire, a spinning purple asterisk, an equestrian statue, a retro error window, a wifi symbol, a bug, a floating TV-headed figure in a red hat and pixel sunglasses, and a Bitcoin sign reading 'I'm hodling it'." loading="lazy" decoding="async" />
  </div>
  <div class="stage-wrap">
  <div class="stage" role="img" aria-label="ForkLore collage: a big yellow 'hi!' on orange, with a Melbourne tram trailing fire, a spinning purple asterisk, an equestrian statue, a retro error window, a wifi symbol, a bug, a floating TV-headed figure in a red hat and pixel sunglasses, and a Bitcoin sign reading 'I'm hodling it'.">
    {layers.map((l) => (
      <img
        class={`layer ${l.name}`}
        src={url(`/images/collage/${l.name}.webp`)}
        width={l.w * 2}
        height={l.h * 2}
        alt=""
        loading="lazy"
        decoding="async"
        style={box(l)}
      />
    ))}
    <div class="layer fire" style={box(fire)} aria-hidden="true">
      <img class="fire-glow" src={url('/images/collage/fire.webp')} alt="" loading="lazy" decoding="async" />
      <img class="fire-body" src={url('/images/collage/fire.webp')} alt="" loading="lazy" decoding="async" />
      <span class="ember e1"></span><span class="ember e2"></span><span class="ember e3"></span>
      <span class="ember e4"></span><span class="ember e5"></span>
    </div>
  </div>
  </div>
  <svg class="defs" width="0" height="0" aria-hidden="true" focusable="false">
    <filter id="fire-heat" x="-10%" y="-25%" width="120%" height="150%">
      <feTurbulence type="fractalNoise" baseFrequency="0.035 0.09" numOctaves="2" seed="3" result="noise">
        <animate attributeName="baseFrequency" dur="1.6s" values="0.035 0.09;0.045 0.12;0.03 0.08;0.035 0.09" repeatCount="indefinite" />
      </feTurbulence>
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="14" xChannelSelector="R" yChannelSelector="G">
        <animate attributeName="scale" dur="0.9s" values="10;16;12;18;10" repeatCount="indefinite" />
      </feDisplacementMap>
    </filter>
  </svg>
</div>

<script>

  // Only animate on large screens, and only while the collage is on screen.
  const el = document.querySelector('.collage');
  const large = matchMedia('(min-width: 1025px)');
  if (el && large.matches && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => el.classList.toggle('playing', e.isIntersecting), { threshold: 0.1 }).observe(el);
  }
</script>

<style>
  .collage { position: relative; overflow: hidden; background: #ff751f; }
  .stage { position: relative; width: 100%; aspect-ratio: 4 / 1; overflow: hidden; }

  /* Phones and tablets get one flat image and no animation; the layered, animated version is for larger screens */
  .static-wrap { position: relative; }
  .stage-wrap { position: relative; display: none; }
  .static { display: block; width: 100%; height: auto; max-width: none; }
  @media (min-width: 1025px) {
    .static-wrap { display: none; }
    .stage-wrap { display: block; }
  }
  .defs { position: absolute; width: 0; height: 0; }
  .layer { position: absolute; height: auto; max-width: none; user-select: none; -webkit-user-drag: none; }
  .layer { animation-play-state: paused !important; }
  .playing .layer { animation-play-state: running !important; }

  /* Fire: heat-warped flames, a flickering glow, and embers drifting off */
  .fire { overflow: visible; aspect-ratio: 99 / 64; transform-origin: 100% 55%; animation: fire-breathe 0.7s ease-in-out infinite alternate; }
  .fire img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .fire-body { filter: url(#fire-heat); }
  .fire-glow { filter: blur(6px) brightness(1.6) saturate(1.4); mix-blend-mode: screen; opacity: 0.4; animation: glow 0.45s steps(3) infinite alternate; animation-play-state: inherit; }
  @keyframes fire-breathe {
    0%   { transform: scale(1, 1); }
    40%  { transform: scale(1.06, 0.95); }
    70%  { transform: scale(0.97, 1.04); }
    100% { transform: scale(1.09, 0.98); }
  }
  @keyframes glow {
    0% { opacity: 0.25; }
    50% { opacity: 0.5; }
    100% { opacity: 0.35; }
  }
  .ember {
    position: absolute;
    right: 18%;
    top: 45%;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #ffd27a;
    box-shadow: 0 0 4px 1px #ff8a1f;
    opacity: 0;
    animation: ember 1.8s ease-out infinite;
    animation-play-state: inherit;
  }
  .e2 { top: 30%; right: 34%; animation-delay: 0.35s; animation-duration: 2.1s; }
  .e3 { top: 60%; right: 26%; animation-delay: 0.8s; width: 2px; height: 2px; }
  .e4 { top: 40%; right: 50%; animation-delay: 1.1s; animation-duration: 1.6s; }
  .e5 { top: 52%; right: 10%; animation-delay: 1.45s; width: 2px; height: 2px; }
  @keyframes ember {
    0%   { transform: translate(0, 0); opacity: 0; }
    15%  { opacity: 1; }
    100% { transform: translate(-34px, -22px); opacity: 0; }
  }

  /* Music notes float up from the music box */
  .note1, .note2 { animation: note 3.4s ease-out infinite; }
  .note2 { animation-delay: 1.7s; }
  @keyframes note {
    0%   { transform: translate(0, 30%) rotate(-6deg); opacity: 0; }
    20%  { opacity: 1; }
    80%  { opacity: 1; }
    100% { transform: translate(18%, -110%) rotate(10deg); opacity: 0; }
  }

  /* The TV-head man and the plant float */
  .man { animation: float 4s ease-in-out infinite; }
  .plant { animation: float 4s ease-in-out infinite; animation-delay: -1.3s; }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5%); }
  }

  @media (max-width: 640px) {
    .static-wrap { width: 166%; margin-left: -8%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .layer, .fire * { animation: none !important; opacity: 1 !important; transform: none !important; }
    .ember { display: none; }
  }

</style>
