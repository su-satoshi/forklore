---
// The ForkLore cover collage, split into layers so some pieces can move.
// Layers are listed bottom to top, positioned on the original 1200 x 300 artboard.
import { url } from '../lib/site';

const layers = [
  { name: 'bg',     x: 0,   y: 0,   w: 1200, h: 300 },
  { name: 'cloud1', x: 770, y: 144, w: 306,  h: 156 },
  { name: 'scene',  x: 0,   y: 0,   w: 1200, h: 300 },
  { name: 'wifi',   x: 478, y: 22,  w: 100,  h: 100 },
  { name: 'plant',  x: 588, y: 84,  w: 53,   h: 120 },
  { name: 'man',    x: 560, y: 62,  w: 202,  h: 238 },
  { name: 'scene2', x: 0,   y: 0,   w: 1200, h: 300 },
  { name: 'bug',    x: 790, y: 0,   w: 139,  h: 99 },
  { name: 'cloud2', x: 196, y: 22,  w: 175,  h: 90 },
  { name: 'note1',  x: 730, y: 103, w: 34,   h: 42 },
  { name: 'note2',  x: 760, y: 94,  w: 26,   h: 32 },
  { name: 'fire',   x: 0,   y: 236, w: 99,   h: 64 },
];
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
---
<div class="collage" role="img" aria-label="ForkLore collage: a big yellow 'hi!' on orange, with a Melbourne tram trailing fire, an equestrian statue, a retro error window, a wifi symbol, a bug, a floating TV-headed figure in a red hat and pixel sunglasses, and a Bitcoin sign reading 'I'm hodling it'.">
  <div class="stage">
    {layers.map((l) => (
      <img
        class={`layer ${l.name}`}
        src={url(`/images/collage/${l.name}.webp`)}
        width={l.w * 2}
        height={l.h * 2}
        alt=""
        loading="lazy"
        decoding="async"
        style={`left:${pct(l.x, 1200)};top:${pct(l.y, 300)};width:${pct(l.w, 1200)}`}
      />
    ))}
  </div>
</div>

<script>
  // Only animate while the collage is on screen.
  const el = document.querySelector('.collage');
  if (el && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => el.classList.toggle('playing', e.isIntersecting), { threshold: 0.1 }).observe(el);
  } else {
    el?.classList.add('playing');
  }
</script>

<style>
  .collage { position: relative; overflow: hidden; background: #ff751f; }
  .stage { position: relative; width: 100%; aspect-ratio: 4 / 1; }
  .layer { position: absolute; height: auto; max-width: none; user-select: none; -webkit-user-drag: none; }
  .layer { animation-play-state: paused !important; }
  .playing .layer { animation-play-state: running !important; }

  /* Fire flickers behind the tram */
  .fire { transform-origin: 100% 60%; animation: flicker 0.9s ease-in-out infinite alternate; }
  @keyframes flicker {
    0%   { transform: scale(1, 1) skewX(0deg); filter: brightness(1); }
    30%  { transform: scale(1.08, 0.94) skewX(-4deg); filter: brightness(1.15); }
    60%  { transform: scale(0.95, 1.06) skewX(3deg); filter: brightness(0.95); }
    100% { transform: scale(1.1, 0.97) skewX(-2deg); filter: brightness(1.2); }
  }

  /* Music notes float up from the music box */
  .note1, .note2 { animation: note 3.4s ease-out infinite; }
  .note2 { animation-delay: 1.7s; }
  @keyframes note {
    0%   { transform: translate(0, 30%) rotate(-6deg); opacity: 0; }
    20%  { opacity: 1; }
    80%  { opacity: 1; }
    100% { transform: translate(18%, -110%) rotate(10deg); opacity: 0; }
  }

  /* Plant shakes */
  .plant { transform-origin: 50% 100%; animation: shake-plant 2.6s ease-in-out infinite; }
  @keyframes shake-plant {
    0%, 100% { transform: rotate(0); }
    10% { transform: rotate(-5deg); }
    20% { transform: rotate(4deg); }
    30% { transform: rotate(-3deg); }
    40% { transform: rotate(2deg); }
    50% { transform: rotate(0); }
  }

  /* Bug shakes, then falls out of the frame, then comes back */
  .bug { transform-origin: 50% 50%; animation: bug 7s infinite; }
  @keyframes bug {
    0%, 100% { transform: translate(0, 0) rotate(0); opacity: 1; animation-timing-function: linear; }
    4%  { transform: translate(-2px, 0) rotate(-6deg); }
    8%  { transform: translate(2px, 0) rotate(6deg); }
    12% { transform: translate(-2px, 0) rotate(-6deg); }
    16% { transform: translate(2px, 0) rotate(6deg); }
    20% { transform: translate(-2px, 0) rotate(-6deg); }
    24% { transform: translate(2px, 0) rotate(6deg); }
    28% { transform: translate(0, 0) rotate(0); animation-timing-function: cubic-bezier(0.55, 0, 0.9, 0.5); }
    50% { transform: translate(4%, 340%) rotate(160deg); opacity: 1; }
    50.1% { transform: translate(0, 0) rotate(0); opacity: 0; }
    62% { opacity: 0; }
    72% { transform: translate(0, 0) rotate(0); opacity: 1; }
  }

  /* Clouds drift slightly */
  .cloud1 { animation: drift 10s ease-in-out infinite; }
  .cloud2 { animation: drift 12s ease-in-out infinite reverse; }
  @keyframes drift {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(3%); }
  }

  /* Wifi signal pulses */
  .wifi { transform-origin: 50% 90%; animation: wifi 2.4s ease-in-out infinite; }
  @keyframes wifi {
    0%, 100% { transform: scale(1); filter: brightness(1); }
    50% { transform: scale(1.06); filter: brightness(1.25); }
  }

  /* The TV-head man floats */
  .man { animation: float 4s ease-in-out infinite; }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5%); }
  }

  @media (max-width: 640px) {
    .stage { width: 166%; margin-left: -8%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .layer { animation: none !important; opacity: 1 !important; transform: none !important; }
  }
</style>
