---
import LogoMark from './LogoMark.astro';
import { url } from '../lib/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '') || '/';
const nav = [
  { href: '/posts', label: 'Posts' },
  { href: '/topics', label: 'Topics' },
  { href: '/about', label: 'About' },
];
---
<header class="site-header">
  <div class="wrap bar">
    <a class="lockup" href={url('/')} aria-label="ForkLore home">
      <LogoMark size="2.1rem" />
      <span class="name">FORK LORE<span class="cursor" aria-hidden="true"></span></span>
    </a>
    <nav aria-label="Main">
      <ul>
        {nav.map((n) => (
          <li><a href={url(n.href)} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
        <li>
          <button class="theme" type="button" aria-label="Switch between dark and light mode">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/></svg>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  document.querySelector('.theme')?.addEventListener('click', () => {
    const root = document.documentElement;
    const light = root.dataset.theme !== 'light';
    if (light) root.dataset.theme = 'light'; else delete root.dataset.theme;
    try { localStorage.setItem('forklore-theme', light ? 'light' : 'dark'); } catch (e) {}
  });
</script>

<style>
  .site-header { border-bottom: 1px solid var(--rule); background: color-mix(in srgb, var(--bg) 88%, transparent); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 12px 24px; flex-wrap: wrap; padding-block: 16px; }
  .lockup { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; padding: 4px 6px 4px 0; }
  .lockup:hover { background: none; color: inherit; }
  .name {
    font-weight: 900;
    font-size: 1.55rem;
    letter-spacing: 0.01em;
    line-height: 1;
    font-variation-settings: 'opsz' 72, 'wght' 900, 'SOFT' 0, 'WONK' 0;
    white-space: nowrap;
  }
  nav ul { display: flex; align-items: center; gap: 4px 22px; list-style: none; margin: 0; padding: 0; flex-wrap: wrap; }
  nav a { font-weight: 600; text-decoration-color: transparent; padding: 2px 0; }
  nav a[aria-current='page'] { text-decoration-color: var(--accent); }
  nav a:hover { background: none; color: var(--accent); }
  .theme {
    display: grid; place-items: center; width: 36px; height: 36px;
    border: 1px solid var(--rule); border-radius: 50%;
    background: transparent; color: var(--ink); cursor: pointer;
  }
  .theme:hover { border-color: var(--accent); color: var(--accent); }
</style>
