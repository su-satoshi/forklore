---
import type { CollectionEntry } from 'astro:content';
import { url, slugify, formatDate, readingTime } from '../lib/site';
interface Props { posts: CollectionEntry<'posts'>[]; headingLevel?: 'h2' | 'h3'; }
const { posts, headingLevel = 'h2' } = Astro.props;
const H = headingLevel;
---
{posts.length === 0 ? (
  <p class="empty">No posts here yet. Add a Markdown file to <code>src/content/posts</code> and it will show up.</p>
) : (
  <ol class="post-list">
    {posts.map((post) => (
      <li class="entry">
        <p class="meta">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>,
          {' '}{readingTime(post)} min read
          {post.data.draft && <span class="draft">Draft</span>}
        </p>
        <H class="title"><a href={url(`/posts/${post.id}`)}>{post.data.title}</a></H>
        <p class="desc">{post.data.description}</p>
        {post.data.tags.length > 0 && (
          <ul class="tags">
            {post.data.tags.map((t) => <li><a class="tag" href={url(`/topics/${slugify(t)}`)}>{t}</a></li>)}
          </ul>
        )}
      </li>
    ))}
  </ol>
)}

<style>
  .post-list { list-style: none; margin: 0; padding: 0; }
  .entry { padding-block: 30px; border-top: 1px solid var(--rule); }
  .entry:first-child { border-top: 0; padding-top: 4px; }
  .meta { margin: 0 0 8px; font-family: var(--font-mono); font-size: 0.8rem; color: var(--label); }
  .title {
    font-weight: 800;
    font-size: clamp(1.5rem, 3.2vw, 2rem);
    line-height: 1.12;
    max-width: 30ch;
    font-variation-settings: 'opsz' 96, 'SOFT' 0, 'WONK' 0;
  }
  .title a { text-decoration-color: transparent; }
  .title a:hover { background: none; color: var(--accent); }
  .desc { margin: 10px 0 14px; max-width: 62ch; }
  .draft { margin-left: 8px; background: var(--brand-violet); color: #fff; padding: 2px 7px; border-radius: 3px; font-size: 0.8rem; font-weight: 700; }
  .empty { padding: 24px; border: 1px dashed var(--rule); }
</style>
