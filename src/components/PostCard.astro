---
import type { CollectionEntry } from 'astro:content';
import { url, slugify, formatDate, readingTime } from '../lib/site';

interface Props { post: CollectionEntry<'posts'>; latest?: boolean; slot?: string }
const { post, latest = false, slot = 'd' } = Astro.props;
const { title, description, pubDate, tags, cover, coverAlt, draft, pinned } = post.data;
const href = url(`/posts/${post.id}`);
const topic = tags[0];
---
<article
  class:list={['card', { latest, pinned }]}
  data-slot={slot}
  data-tags={tags.map(slugify).join(' ')}
  data-search={`${title} ${description} ${tags.join(' ')}`.toLowerCase()}
>
  {cover && <img class="cover" src={url(cover)} alt={coverAlt ?? ''} loading="lazy" decoding="async" />}
  <div class="panel">
    <span class="tab">
      {pinned
        ? <span class="badge">Pinned</span>
        : latest
        ? <span class="badge">Latest</span>
        : topic
          ? <a class="badge" href={url(`/topics/${slugify(topic)}`)}>{topic}</a>
          : <span class="badge">Post</span>}
    </span>
    <h3 class="title"><a href={href}>{title}</a></h3>
    <p class="desc">{description}</p>
    <p class="meta">
      {(latest || pinned) && topic && <a class="chip" href={url(`/topics/${slugify(topic)}`)}>{topic}</a>}
      {draft && <span class="draft">Draft</span>}
      <span><time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>, {readingTime(post)} min read</span>
    </p>
  </div>
</article>

<style>
  /* Orange card; the white panel sits at the bottom with orange space above it */
  .card {
    --r: 28px;
    --tab-r: 16px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    min-height: 280px;
    padding: 96px 14px 14px;
    border-radius: var(--r);
    overflow: hidden;
    isolation: isolate;
    background: #ed6c1d;
    border: 2px solid #000;
  }
  /* Faint grid-paper texture */
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.12) 1px, transparent 1px);
    background-size: 26px 26px;
  }
  .cover { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -1; }

  /* The panel: same shape on every card, a tab rising from its top-left corner */
  .panel {
    position: relative;
    width: 100%;
    background: var(--surface);
    color: var(--ink);
    border-radius: 0 calc(var(--r) - 8px) calc(var(--r) - 8px) calc(var(--r) - 8px);
    padding: 16px 20px 18px;
  }
  .tab {
    position: absolute;
    left: 0;
    bottom: calc(100% - 1px);
    max-width: calc(100% - 40px);
    padding: 10px 10px 0;
    background: var(--surface);
    border-radius: var(--tab-r) var(--tab-r) 0 0;
  }
  /* Concave curve where the tab meets the panel edge */
  .tab::after {
    content: '';
    position: absolute;
    left: 100%;
    bottom: 0;
    width: var(--tab-r);
    height: var(--tab-r);
    background: radial-gradient(circle at 100% 0, transparent calc(var(--tab-r) - 0.5px), var(--surface) var(--tab-r));
  }
  .badge {
    position: relative;
    z-index: 1;
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-weight: 700;
    font-size: 0.8rem;
    line-height: 1.2;
    background-image: none;
  }
  a.badge:hover { background: var(--yellow); color: #000; }

  .title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.1rem, 1.55vw, 1.3rem);
    line-height: 1.15;
    letter-spacing: 0.02em;
    margin: 0;
    overflow-wrap: break-word;
  }
  /* Whichever post lands in the wide slot gets the bigger title */
  .card[data-slot='d'] .title { font-size: clamp(1.35rem, 2.3vw, 1.85rem); }
  .title a { background-size: 100% 0; }
  .title a::after { content: ''; position: absolute; inset: 0; z-index: 0; }
  .title a:hover { background-size: 100% 0.32em; }
  .desc {
    margin: 8px 0 12px;
    font-size: 0.92rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .meta { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 12px; margin: 0; font-size: 0.82rem; color: var(--ink-soft); }
  .chip {
    position: relative;
    z-index: 1;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    font-weight: 600;
    background-image: none;
  }
  .chip:hover { background: var(--yellow); color: #000; }
  .draft { padding: 4px 10px; border-radius: 999px; background: var(--red); color: #fff; font-weight: 700; font-size: 0.78rem; }
  .card:has(.title a:focus-visible) { outline: 3px solid var(--blue); outline-offset: 3px; }
  .title a:focus-visible { outline: none; }
</style>
