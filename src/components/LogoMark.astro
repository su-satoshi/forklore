---
// The ForkLore mark: a split "O" with a branching node running through it.
interface Props { size?: string; cursor?: boolean; class?: string; title?: string }
const { size = '1em', cursor = false, class: cls, title } = Astro.props;
---
<svg
  class:list={['mark', cls]}
  viewBox={cursor ? '0 0 112 100' : '0 0 100 100'}
  width={size}
  height={size}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
  style={cursor ? `width:calc(${size} * 1.12)` : undefined}
>
  <g fill="none" style="stroke: var(--mark-ring, #F8F3EA); stroke-width: var(--ring-w, 13)">
    <path d="M38.5 23.6 A30.5 30.5 0 0 0 38.5 80.4" />
    <path d="M61.5 23.6 A30.5 30.5 0 0 1 61.5 80.4" />
  </g>
  <g fill="none" style="stroke: var(--mark-node, #FF8A3D)" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M50 11 V45 L43 55 V91" />
    <path d="M43 72 L57 61" />
  </g>
  <g style="fill: var(--mark-node, #FF8A3D)">
    <circle cx="50" cy="10" r="7.5" />
    <circle cx="59" cy="59.5" r="6.5" />
    {cursor && <rect x="88" y="88" width="22" height="6" />}
  </g>
</svg>
