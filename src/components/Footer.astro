---
import Collage from './Collage.astro';
import { SITE, url } from '../lib/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap footer-inner">
    <p class="sign">
      Written and built by {SITE.author} in Melbourne. Follow the evidence, question the assumptions.
    </p>
    <ul class="links">
      <li><a href={url('/rss.xml')}>RSS</a></li>
      <li><a href={SITE.github} rel="me">GitHub</a></li>
      <li><a href={SITE.coffee}>Buy me a coffee</a></li>
    </ul>
    <p class="copy">&copy; {year} ForkLore</p>
  </div>
  <Collage />
</footer>

<style>
  .site-footer { --page-radius: clamp(24px, 4vw, 48px); margin-top: 96px; border-top: 3px solid var(--ink); }
  /* The footer artwork has rounded top corners, with the page showing behind them */
  .site-footer :global(.collage) { border-radius: var(--page-radius) var(--page-radius) 0 0; }
  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px 32px;
    padding-block: 28px 32px;
    align-items: start;
  }
  .sign { margin: 0; max-width: 46ch; }
  .links { display: flex; gap: 20px; list-style: none; margin: 0; padding: 0; font-weight: 600; flex-wrap: wrap; }
  .copy { margin: 0; color: var(--ink-soft); font-size: 0.9rem; }
  @media (max-width: 640px) {
    .footer-inner { grid-template-columns: 1fr; }
  }
</style>
