---
import Collage from './Collage.astro';
import { SITE, url } from '../lib/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="panel">
  <div class="card">
  <div class="wrap footer-inner">
    <section class="subscribe" aria-labelledby="subscribe-title">
      <h2 id="subscribe-title">Subscribe to the mailing list</h2>
      <p class="sub-note">Stay updated on new posts, straight to your inbox. No spam, unsubscribe any time.</p>
      <form
        class="sub-form"
        action={SITE.newsletterAction || undefined}
        method="post"
        target="_blank"
        data-live={SITE.newsletterAction ? 'true' : 'false'}
      >
        <label class="visually-hidden" for="sub-email">Email address</label>
        <input id="sub-email" type="email" name="email" required placeholder="you@example.com" autocomplete="email" />
        <button type="submit">Subscribe</button>
      </form>
      <p class="sub-status" role="status" hidden></p>
    </section>
    <div class="about">
    <ul class="links">
      <li>
        <a class="icon-link" href={url('/rss.xml')} aria-label="RSS feed" title="RSS feed">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="6.18" cy="17.82" r="2.18" fill="currentColor"/><path fill="currentColor" d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z"/></svg>
        </a>
      </li>
      <li>
        <a class="icon-link" href={SITE.github} rel="me" aria-label="GitHub" title="GitHub">
          <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        </a>
      </li>
      <li>
        <a class="icon-link" href={SITE.coffee} aria-label="Buy me a coffee" title="Buy me a coffee">
          <svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9h13v4.5A5.5 5.5 0 0 1 11.5 19h-2A5.5 5.5 0 0 1 4 13.5z" fill="currentColor" stroke="none"/><path d="M17 11h1.5a2.5 2.5 0 0 1 0 5H16.5"/><path d="M8 2.5c-.6.9.6 1.6 0 2.5M12 2.5c-.6.9.6 1.6 0 2.5"/><path d="M3 21.5h15"/></svg>
        </a>
      </li>
    </ul>
      <p class="sign">
        Written and built by {SITE.author} in Melbourne. Follow the evidence, question the assumptions.
      </p>
      <p class="copy">&copy; {year} ForkLore</p>
    </div>
  </div>
  </div>
  </div>
  <Collage />
</footer>

<script>
  // Until the mailing list service is connected, don't send the address anywhere; say so instead.
  const form = document.querySelector<HTMLFormElement>('.sub-form');
  const status = document.querySelector<HTMLElement>('.sub-status');
  form?.addEventListener('submit', (e) => {
    if (form.dataset.live === 'true') return;
    e.preventDefault();
    if (status) {
      status.textContent = "Sign-ups open very soon. Your address wasn't saved, so please check back shortly.";
      status.hidden = false;
    }
  });
</script>

<style>
  .site-footer { --page-radius: clamp(24px, 4vw, 48px); --card-inset: clamp(10px, 1.4vw, 18px); margin-top: 96px; }
  /* The page ends in a rounded edge that sits over the collage */
  .panel {
    position: relative;
    z-index: 1;
    background-color: var(--paper);
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 26px 26px;
    background-attachment: fixed;
    border-radius: 0 0 var(--page-radius) var(--page-radius);
    padding: 0 var(--card-inset) var(--card-inset);
  }
  /* Black footer card, rounded on all sides with the same radius as the page bottom */
  .card {
    --card-bg: #000;
    --card-ink: #f3efe4;
    --card-soft: rgba(243, 239, 228, 0.62);
    --card-ring: rgba(243, 239, 228, 0.35);
    background: var(--card-bg);
    color: var(--card-ink);
    border-radius: calc(var(--page-radius) - var(--card-inset) / 2);
  }
  /* In dark mode the card flips to the light-mode page colour */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .card { --card-bg: #f3efe4; --card-ink: #000; --card-soft: rgba(0, 0, 0, 0.6); --card-ring: rgba(0, 0, 0, 0.35); }
  }
  :global(:root[data-theme='dark']) .card { --card-bg: #f3efe4; --card-ink: #000; --card-soft: rgba(0, 0, 0, 0.6); --card-ring: rgba(0, 0, 0, 0.35); }
  .card a { --link-mark: #ed6c1d; background-image: linear-gradient(#ed6c1d, #ed6c1d); }
  .card a:hover { color: #000; }
  .card :focus-visible { outline-color: #0386fa; }
  .site-footer :global(.collage) { margin-top: calc(-1 * var(--page-radius)); padding-top: var(--page-radius); }
  .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 28px 56px;
    padding-block: 36px 40px;
    align-items: start;
  }
  .about { display: flex; flex-direction: column; align-items: flex-end; gap: 16px; text-align: right; }
  .about .sign { max-width: 40ch; }

  /* Email subscribe */
  .subscribe h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    letter-spacing: -0.01em;
    line-height: 1.05;
    margin: 0 0 8px;
  }
  .sub-note { margin: 0 0 16px; color: var(--card-soft); font-size: 0.95rem; }
  .sub-form { display: flex; flex-wrap: wrap; gap: 8px; max-width: 460px; }
  .sub-form input { flex: 1 1 200px; }
  .sub-form input {
    flex: 1;
    min-width: 0;
    padding: 12px 16px;
    border-radius: 999px;
    border: 1.5px solid var(--card-ring);
    background: transparent;
    color: var(--card-ink);
    font: inherit;
    font-size: 0.95rem;
  }
  .sub-form input::placeholder { color: var(--card-soft); }
  .sub-form input:focus-visible { outline: 2px solid #ed6c1d; outline-offset: 2px; }
  .sub-form button {
    padding: 12px 20px;
    border-radius: 999px;
    border: 0;
    background: #ed6c1d;
    color: #000;
    font: inherit;
    font-weight: 700;
    font-size: 0.95rem;
  }
  .sub-form button:hover { background: #ffde59; }
  .sub-status { margin: 10px 0 0; font-size: 0.9rem; color: #ffde59; }
  .sign { margin: 0; max-width: 46ch; }
  .links { display: flex; gap: 12px; list-style: none; margin: 0; padding: 0; }
  .card .icon-link {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1.5px solid var(--card-ring);
    color: var(--card-ink);
    background: none;
    background-image: none;
    transition: background-color 140ms ease, color 140ms ease, border-color 140ms ease;
  }
  .card .icon-link:hover { background: #ed6c1d; border-color: #ed6c1d; color: #000; }
  .copy { margin: 0; color: var(--card-soft); font-size: 0.9rem; }
  @media (max-width: 760px) {
    .footer-inner { grid-template-columns: minmax(0, 1fr); }
    .about { align-items: flex-start; text-align: left; }
  }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
