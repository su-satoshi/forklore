---
import type { CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';
import { slugify } from '../lib/site';
import { SLOTS, chunk } from '../lib/bento';

interface Props {
  posts: CollectionEntry<'posts'>[];
  filters?: boolean;
  heading?: string;
  intro?: string;
}
const { posts: input, filters = false, heading, intro } = Astro.props;
// Pinned posts first, then everything else newest first (input is already sorted by date)
const posts = [...input.filter((p) => p.data.pinned), ...input.filter((p) => !p.data.pinned)];
const latestId = posts.find((p) => !p.data.pinned)?.id;
const counts = new Map<string, number>();
posts.forEach((p) => p.data.tags.forEach((t) => counts.set(t, (counts.get(t) ?? 0) + 1)));
const topics = [...counts.entries()].sort((a, b) => b[1] - a[1]);
const blocks = chunk(posts);
---
{filters && (
  <section class="bar" aria-label="Filter posts">
    <div class="bar-search">
      <label class="search">
        <span class="visually-hidden">Search posts</span>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="m20 20-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <input type="search" placeholder="Search posts" autocomplete="off" />
      </label>
    </div>
    {heading && <h1 class="bar-title">{heading}</h1>}
    {intro && <p class="bar-intro">{intro}</p>}
    <div class="filters" role="group" aria-label="Topics">
      <button type="button" class="pill" aria-pressed="true" data-tag="">All <span>{posts.length}</span></button>
      {topics.map(([t, n]) => (
        <button type="button" class="pill" aria-pressed="false" data-tag={slugify(t)}>{t} <span>{n}</span></button>
      ))}
    </div>
  </section>
)}

{posts.length === 0 ? (
  <p class="empty">No posts yet. Add a Markdown file to <code>src/content/posts</code> and it will show up here.</p>
) : (
  <div class="bento">
    {blocks.map((block) => (
      <div class={`block n${block.length}`}>
        {block.map((post, i) => <PostCard post={post} latest={post.id === latestId} slot={SLOTS[block.length][i]} />)}
      </div>
    ))}
  </div>
)}
<p class="no-match" hidden>No posts match that. Try another topic or a different search.</p>

<script>
  import { SLOTS, chunk } from '../lib/bento';
  const bar = document.querySelector('.bar');
  if (bar) {
    const bento = document.querySelector<HTMLElement>('.bento');
    const cards = [...document.querySelectorAll<HTMLElement>('.bento .card')];
    // Rebuild the blocks from the cards that are still visible, so filtered results keep a flush layout
    const relayout = (visible: HTMLElement[]) => {
      if (!bento) return;
      bento.replaceChildren();
      for (const group of chunk(visible)) {
        const block = document.createElement('div');
        block.className = `block n${group.length}`;
        group.forEach((c, j) => { c.dataset.slot = SLOTS[group.length][j]; block.append(c); });
        bento.append(block);
      }
    };
    const pills = [...bar.querySelectorAll<HTMLButtonElement>('.pill')];
    const input = bar.querySelector<HTMLInputElement>('input');
    const none = document.querySelector<HTMLElement>('.no-match');
    let tag = '';
    const apply = () => {
      const q = (input?.value ?? '').trim().toLowerCase();
      const visible = cards.filter((c) => (!tag || (c.dataset.tags ?? '').split(' ').includes(tag)) && (!q || (c.dataset.search ?? '').includes(q)));
      relayout(visible);
      if (none) none.hidden = visible.length > 0;
    };
    pills.forEach((p) => p.addEventListener('click', () => {
      tag = p.dataset.tag ?? '';
      pills.forEach((x) => x.setAttribute('aria-pressed', String(x === p)));
      apply();
    }));
    input?.addEventListener('input', apply);
  }
</script>

<style>
  /* Black rounded box: search at the top, then the intro, then the topics row */
  .bar {
    --r: 28px;
    background: #000;
    color: #f3efe4;
    border-radius: var(--r);
    padding: clamp(14px, 2vw, 18px) clamp(20px, 3vw, 32px) clamp(20px, 3vw, 28px);
    margin: 0 0 16px;
  }
  /* Search spans the full width of the box */
  .bar-search { width: 100%; margin: 0 0 18px; }
  .bar-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.4rem, 6vw, 4rem);
    letter-spacing: -0.015em;
    line-height: 1;
    margin: 0 0 12px;
  }
  .bar-intro { margin: 0 0 20px; color: rgba(243, 239, 228, 0.78); line-height: 1.55; }
  /* Topics wrap across the full width of the box, left aligned */
  .filters { display: flex; flex-wrap: wrap; justify-content: flex-start; gap: 8px; }
  .pill {
    flex: none;
    white-space: nowrap;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 8px 14px;
    border-radius: 999px;
    border: 0;
    background: #26272d;
    color: #f3efe4;
  }
  .pill span { opacity: 0.6; font-weight: 400; margin-left: 2px; }
  .pill:hover { background: #3a3b42; }
  .pill[aria-pressed='true'] { background: #f3efe4; color: #000; }
  .search {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-radius: 12px;
    background: #26272d;
    color: rgba(243, 239, 228, 0.7);
  }
  .search:focus-within { outline: 2px solid var(--yellow); }
  .search input { flex: 1; min-width: 0; border: 0; background: none; color: #f3efe4; font: inherit; font-size: 0.95rem; outline: none; }
  .search input::placeholder { color: rgba(243, 239, 228, 0.5); }

  /* Bento blocks: sizes vary, but every column in a block ends on the same line.
     Blocks are rebuilt by script when filtering, so their rules are global (scoped under .bento). */
  .bento { display: grid; gap: 16px; }
  .bento :global(.block) { display: grid; gap: 16px; grid-auto-rows: minmax(250px, auto); }
  .bento :global(.block > [data-slot='a']) { grid-area: a; }
  .bento :global(.block > [data-slot='b']) { grid-area: b; }
  .bento :global(.block > [data-slot='c']) { grid-area: c; }
  .bento :global(.block > [data-slot='d']) { grid-area: d; }
  .bento :global(.block > [data-slot='e']) { grid-area: e; }
  .bento :global(.block > [data-slot='f']) { grid-area: f; }

  .bento :global(.n6) { grid-template-columns: 1fr 0.9fr 0.9fr 1.25fr; grid-template-areas: 'a c d d' 'b c e f'; }
  .bento :global(.n5) { grid-template-columns: 1fr 0.9fr 2fr; grid-template-areas: 'a c d' 'b c e'; }
  .bento :global(.n4) { grid-template-columns: 0.9fr 1fr 1fr; grid-template-areas: 'c d d' 'c e f'; }
  .bento :global(.n3) { grid-template-columns: 1fr 1.5fr; grid-template-areas: 'c d' 'c e'; }
  .bento :global(.n2) { grid-template-columns: 1.6fr 1fr; grid-template-areas: 'd c'; }
  .bento :global(.n1) { grid-template-columns: 1fr; grid-template-areas: 'd'; }

  @media (max-width: 960px) {
    .bento :global(.n6) { grid-template-columns: 1fr 1fr; grid-template-areas: 'd d' 'c a' 'c b' 'e f'; }
    .bento :global(.n5) { grid-template-columns: 1fr 1fr; grid-template-areas: 'd d' 'c a' 'c b' 'e e'; }
    .bento :global(.n4) { grid-template-columns: 1fr 1fr; grid-template-areas: 'd d' 'c e' 'c f'; }
    .bento :global(.n3) { grid-template-columns: 1fr 1fr; grid-template-areas: 'd d' 'c e'; }
  }
  @media (max-width: 640px) {
    .bento :global(.block) { grid-template-columns: 1fr !important; grid-template-areas: none !important; grid-auto-rows: auto; }
    .bento :global(.block > .card) { grid-area: auto !important; }
  }
  .empty, .no-match { padding: 24px; border: 2px dashed var(--ink-soft); border-radius: 20px; }
</style>
