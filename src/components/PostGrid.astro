---
import type { CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';
import { slugify } from '../lib/site';

interface Props {
  posts: CollectionEntry<'posts'>[];
  filters?: boolean;
  heading?: string;
  intro?: string;
}
const { posts, filters = false, heading, intro } = Astro.props;
const counts = new Map<string, number>();
posts.forEach((p) => p.data.tags.forEach((t) => counts.set(t, (counts.get(t) ?? 0) + 1)));
const topics = [...counts.entries()].sort((a, b) => b[1] - a[1]);

// Bento layout: posts go into blocks of up to six. Each block size has its own
// pattern (see the CSS below) so every column in a block ends on the same line.
// Slot order: the first post in a block takes the wide top slot (d), the second
// the tall slot (c), then the small ones.
const SLOTS: Record<number, string[]> = {
  6: ['d', 'c', 'a', 'b', 'e', 'f'],
  5: ['d', 'c', 'a', 'b', 'e'],
  4: ['d', 'c', 'e', 'f'],
  3: ['d', 'c', 'e'],
  2: ['d', 'c'],
  1: ['d'],
};
const blocks: CollectionEntry<'posts'>[][] = [];
for (let i = 0; i < posts.length; i += 6) blocks.push(posts.slice(i, i + 6));
---
{filters && (
  <section class="bar" aria-label="Filter posts">
    {heading && <h2 class="bar-title">{heading}</h2>}
    {intro && <p class="bar-intro">{intro}</p>}
    <div class="bar-row">
      <div class="filters" role="group" aria-label="Topics">
        <button type="button" class="pill" aria-pressed="true" data-tag="">All <span>{posts.length}</span></button>
        {topics.map(([t, n]) => (
          <button type="button" class="pill" aria-pressed="false" data-tag={slugify(t)}>{t} <span>{n}</span></button>
        ))}
      </div>
      <label class="search">
        <span class="visually-hidden">Search posts</span>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="m20 20-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <input type="search" placeholder="Search posts" autocomplete="off" />
      </label>
    </div>
  </section>
)}

{posts.length === 0 ? (
  <p class="empty">No posts yet. Add a Markdown file to <code>src/content/posts</code> and it will show up here.</p>
) : (
  <div class="bento">
    {blocks.map((block, b) => (
      <div class={`block n${block.length}`}>
        {block.map((post, i) => <PostCard post={post} latest={b === 0 && i === 0} slot={SLOTS[block.length][i]} />)}
      </div>
    ))}
  </div>
)}
<p class="no-match" hidden>No posts match that. Try another topic or a different search.</p>

<script>
  const bar = document.querySelector('.bar');
  if (bar) {
    const bento = document.querySelector<HTMLElement>('.bento');
    const cards = [...document.querySelectorAll<HTMLElement>('.bento .card')];
    const SLOTS: Record<number, string[]> = {
      6: ['d', 'c', 'a', 'b', 'e', 'f'], 5: ['d', 'c', 'a', 'b', 'e'], 4: ['d', 'c', 'e', 'f'],
      3: ['d', 'c', 'e'], 2: ['d', 'c'], 1: ['d'],
    };
    // Rebuild the blocks from the cards that are still visible, so filtered results keep a flush layout
    const relayout = (visible: HTMLElement[]) => {
      if (!bento) return;
      bento.replaceChildren();
      for (let i = 0; i < visible.length; i += 6) {
        const group = visible.slice(i, i + 6);
        const block = document.createElement('div');
        block.className = `block n${group.length}`;
        group.forEach((c, j) => { c.dataset.slot = SLOTS[group.length][j]; block.append(c); });
        bento.append(block);
      }
    };
    const pills = [...bar.querySelectorAll<HTMLButtonElement>('.pill')];
    const input = bar.querySelector<HTMLInputElement>('input');
    const none = document.querySelector<HTMLElement>('.no-match');
    let tag = '';
    const apply = () => {
      const q = (input?.value ?? '').trim().toLowerCase();
      const visible = cards.filter((c) => (!tag || (c.dataset.tags ?? '').split(' ').includes(tag)) && (!q || (c.dataset.search ?? '').includes(q)));
      relayout(visible);
      if (none) none.hidden = visible.length > 0;
    };
    pills.forEach((p) => p.addEventListener('click', () => {
      tag = p.dataset.tag ?? '';
      pills.forEach((x) => x.setAttribute('aria-pressed', String(x === p)));
      apply();
    }));
    input?.addEventListener('input', apply);
  }
</script>

<style>
  .bar {
    background: #000;
    color: #f3efe4;
    border-radius: 28px;
    padding: clamp(20px, 3vw, 32px);
    margin-bottom: 16px;
  }
  .bar-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.4rem, 6vw, 4rem);
    letter-spacing: 0.005em;
    line-height: 1;
    margin: 0 0 12px;
  }
  .bar-intro { margin: 0 0 22px; max-width: 62ch; color: rgba(243, 239, 228, 0.78); line-height: 1.55; }
  .bar-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px 32px; flex-wrap: wrap; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; flex: 1 1 420px; }
  .pill {
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 8px 14px;
    border-radius: 999px;
    border: 0;
    background: #26272d;
    color: #f3efe4;
    cursor: pointer;
  }
  .pill span { opacity: 0.6; font-weight: 400; margin-left: 2px; }
  .pill:hover { background: #3a3b42; }
  .pill[aria-pressed='true'] { background: #f3efe4; color: #000; }
  .search {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 0 1 300px;
    padding: 10px 14px;
    border-radius: 12px;
    background: #26272d;
    color: rgba(243, 239, 228, 0.7);
  }
  .search:focus-within { outline: 2px solid var(--yellow); }
  .search input { flex: 1; min-width: 0; border: 0; background: none; color: #f3efe4; font: inherit; font-size: 0.95rem; outline: none; }
  .search input::placeholder { color: rgba(243, 239, 228, 0.5); }

  /* Bento blocks: sizes vary, but every column in a block ends on the same line */
  .bento { display: grid; gap: 16px; }
  .block { display: grid; gap: 16px; grid-auto-rows: minmax(250px, auto); }
  .block > :global([data-slot='a']) { grid-area: a; }
  .block > :global([data-slot='b']) { grid-area: b; }
  .block > :global([data-slot='c']) { grid-area: c; }
  .block > :global([data-slot='d']) { grid-area: d; }
  .block > :global([data-slot='e']) { grid-area: e; }
  .block > :global([data-slot='f']) { grid-area: f; }

  .n6 { grid-template-columns: 1fr 0.9fr 0.9fr 1.25fr; grid-template-areas: 'a c d d' 'b c e f'; }
  .n5 { grid-template-columns: 1fr 0.9fr 2fr; grid-template-areas: 'a c d' 'b c e'; }
  .n4 { grid-template-columns: 0.9fr 1fr 1fr; grid-template-areas: 'c d d' 'c e f'; }
  .n3 { grid-template-columns: 1fr 1.5fr; grid-template-areas: 'c d' 'c e'; }
  .n2 { grid-template-columns: 1.6fr 1fr; grid-template-areas: 'd c'; }
  .n1 { grid-template-columns: 1fr; grid-template-areas: 'd'; }

  @media (max-width: 960px) {
    .n6 { grid-template-columns: 1fr 1fr; grid-template-areas: 'd d' 'c a' 'c b' 'e f'; }
    .n5 { grid-template-columns: 1fr 1fr; grid-template-areas: 'd d' 'c a' 'c b' 'e e'; }
    .n4 { grid-template-columns: 1fr 1fr; grid-template-areas: 'd d' 'c e' 'c f'; }
    .n3 { grid-template-columns: 1fr 1fr; grid-template-areas: 'd d' 'c e'; }
  }
  @media (max-width: 640px) {
    .block { grid-template-columns: 1fr !important; grid-template-areas: none !important; grid-auto-rows: auto; }
    .block > :global(.card) { grid-area: auto !important; }
  }
  .empty, .no-match { padding: 24px; border: 2px dashed var(--ink-soft); border-radius: 20px; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
