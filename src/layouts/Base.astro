---
import '@fontsource-variable/urbanist/wght.css';
import '@fontsource-variable/montserrat/wght.css';
import '@fontsource-variable/montserrat/wght-italic.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import { SITE, url } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
}
const { title, description = SITE.description, type = 'website' } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} - tech, security and the stories in the code`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isHome = (Astro.url.pathname.replace(base, '') || '/') === '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url('/images/og.jpg'), Astro.site);
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <!-- Only load scripts, styles, fonts and images from this site; forms may post to the mailing list service -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; form-action 'self' https://api.follow.it; base-uri 'self'; object-src 'none'"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={url('/rss.xml')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f3efe4" />
    <script is:inline>
      try {
        const t = localStorage.getItem('forklore-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header>
      <Header />
      <Masthead home={isHome} />
    </header>
    <main id="content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
